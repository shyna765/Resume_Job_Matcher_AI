      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -384,
        0
      ],
      "id": "d93087c8-368a-4cc9-9207-d926f387b6d8",
      "name": "On form submission",
      "webhookId": "c225913a-1b7a-4f41-b896-2330b3af535a"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a7f2665b-19d1-4436-830d-b1668b0fee6e",
              "name": "resume_text",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "0da13cfa-d392-4869-9277-6448e5bd9100",
              "name": "job_description",
              "value": "={{ $json[\"Job Description\"] || $json.jd_pdf_text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        0
      ],
      "id": "95fa1820-0ed9-4626-b286-636ec0b1ac19",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=You are an expert technical recruiter.\n\nAnalyze the candidate's resume against the job description.\n\nRESUME:\n{{ $json.resume_text }}\n\nJOB DESCRIPTION:\n{{ $json.job_description }}\n\nReturn the analysis as JSON using exactly the structure specified by the output schema.\n\nImportant:\n- Only consider a skill as a match if there is evidence for it in the resume.\n- If a skill is not demonstrated in the resume, put it under missing_skills.\n- Do not invent experience, technologies, projects, metrics, or qualifications.\n- The match score must be between 0 and 100.\n- Base the score on how well the candidate's demonstrated skills and experience match the requirements of the job.\n- Keep suggestions specific to this job description."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"match_score\": {\n      \"type\": \"number\",\n      \"description\": \"Overall resume to job description match score from 0 to 100.\"\n    },\n    \"matching_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Skills explicitly demonstrated in the resume that match the job description.\"\n    },\n    \"missing_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Important skills from the job description that are not demonstrated in the resume.\"\n    },\n    \"strengths\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"The candidate's strongest areas relevant to this job.\"\n    },\n    \"suggestions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Specific suggestions for improving the resume for this job.\"\n    }\n  },\n  \"required\": [\n    \"match_score\",\n    \"matching_skills\",\n    \"missing_skills\",\n    \"strengths\",\n    \"suggestions\"\n  ],\n  \"additionalProperties\": false\n}"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "id": "a9a688e6-dc76-4ab3-98ab-75c461196a1d",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst result = data.output[0].content[0].text;\n\nreturn [\n  {\n    json: result\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "2d971218-a1e0-4110-be3a-a621cd32bb1b",
      "name": "flatten AI"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "fcb29d8a-5f42-41c0-8928-b4871cfb0429",
              "leftValue": "={{ $json.match_score }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1216,
        0
      ],
      "id": "e7192189-4a45-42dc-9057-584e5ab81a88",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      result: \"Needs Improvement\",\n      match_score: $json.match_score,\n      matching_skills: $json.matching_skills,\n      missing_skills: $json.missing_skills,\n      strengths: $json.strengths,\n      suggestions: $json.suggestions\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        96
      ],
      "id": "e278821c-97c2-4b8b-aadf-f06d69a7deac",
      "name": "Needs Improvement"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      result: \"Strong Match\",\n      match_score: $json.match_score,\n      matching_skills: $json.matching_skills,\n      strengths: $json.strengths,\n      suggestions: $json.suggestions\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -96
      ],
      "id": "5135a836-cabe-4ab6-bd02-ac3a867ab3bd",
      "name": "Strong Match"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1808,
        32
      ],
      "id": "273adba8-0120-4306-bef3-a929cc531aec",
      "name": "Merge",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Format lists\nconst matchingSkills = (data.matching_skills || [])\n  .map(skill => `✓ ${skill}`)\n  .join('\\n');\n\nconst missingSkills = (data.missing_skills || [])\n  .map(skill => `✗ ${skill}`)\n  .join('\\n');\n\nconst strengths = (data.strengths || [])\n  .map(strength => `• ${strength}`)\n  .join('\\n');\n\nconst suggestions = (data.suggestions || [])\n  .map((suggestion, index) => `${index + 1}) ${suggestion}`)\n  .join('\\n');\n\n// Match status\nconst status =\n  data.match_score >= 80\n    ? \"STRONG MATCH\"\n    : \"NEEDS IMPROVEMENT\";\n\n// Clean report\nconst report = `\n${status}\n\nMATCH SCORE\n${data.match_score}/100\n\n\nMATCHING SKILLS\n${matchingSkills || \"None identified\"}\n\n\nMISSING SKILLS\n${missingSkills || \"None identified\"}\n\n\nKEY STRENGTHS\n${strengths || \"None identified\"}\n\n\nRECOMMENDATIONS\n${suggestions || \"No recommendations available\"}\n`;\n\nreturn [\n  {\n    json: {\n      result: data.result,\n      match_score: data.match_score,\n      report: report.trim()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        32
      ],
      "id": "2da35256-cc69-49db-a49d-dff8d541407e",
      "name": "Create clean report"
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Resume Match Report",
        "completionMessage": "={{ $json.report }}",
        "options": {}
      },
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
