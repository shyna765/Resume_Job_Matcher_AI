{
  "name": "AI Resume Job matcher",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI Resume Job Matcher",
        "formDescription": "Upload your resume and paste a job description to see how well your resume matches the role.",
        "formFields": {
